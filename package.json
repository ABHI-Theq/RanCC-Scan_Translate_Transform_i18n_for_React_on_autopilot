{
  "name": "RanC",
  "version": "1.0.0",
  "description": "AI-powered i18n automation CLI for React — scan, translate, and transform hardcoded strings into react-i18next calls",
  "type": "module",
  "private": false,
  "bin": {
    "ranc": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node --format esm --external prettier",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "i18n",
    "react",
    "react-i18next",
    "internationalization",
    "translation",
    "cli",
    "automation",
    "babel",
    "ast",
    "openai",
    "groq",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.68",
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@clack/core": "^1.4.1",
    "@clack/prompts": "^1.5.1",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.9.2",
    "ai": "^6.0.197",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "prettier": "^3.8.3"
  }
}
